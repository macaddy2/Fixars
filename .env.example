# Supabase Configuration
# Get these from your Supabase project: Settings → API
# Never commit your real .env file — it is gitignored.
# isSupabaseConfigured() stays hard-false. Do not enable Supabase as prod.

VITE_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_ANON_KEY>

# Optional: Gemini AI recommendations (do NOT use production keys in the browser;
# proxy via a backend in production).
# VITE_GEMINI_API_KEY=<YOUR_GEMINI_KEY>

# Real-session stack — leave unset. A Pages build must stay the public demo.
# Only a named internal preview may set these. Never set them on the GitHub
# Pages workflow. No live Paystack / NIMC / bank rails.
# VITE_REAL_SESSION=1
# REAL_SESSION=1
# SESSION_SECRET=<long-random-server-only-value>
# COOKIE_SECURE=1
# PORT=8787
# File-backed session + ledger + escrow (default is in-memory for tests).
# PERSISTENCE=file
# DATA_DIR=data
# Mock NIN/BVN port (default off). Still liveNetwork: false. No NIMC call.
# KYC_PORT=1
# VITE_KYC_PORT=1
