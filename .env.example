# Supabase Configuration
# Get these from your Supabase project: Settings → API
# Never commit your real .env file — it is gitignored.
#
# SANDBOX POLICY: the public demo/Pages build must stay mock-only. The app
# only talks to Supabase when BOTH the vars below are set AND
# VITE_REAL_SESSION=1 (internal preview stacks only). Never set these on the
# GitHub Pages workflow.
VITE_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR_ANON_KEY>

# Real-session stack — leave unset on public builds. Only a named internal
# preview may set these. No live Paystack / NIMC / bank rails without them,
# and staking UI additionally stays hidden until VITE_VESTDEN_STAKING=1.
# VITE_REAL_SESSION=1
# VITE_VESTDEN_STAKING=1

# ── Server-side secrets (NOT VITE_ vars — never ship to the browser) ──
# Set on the Edge Functions runtime:
#
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_test_xxx
#   supabase secrets set GEMINI_API_KEY=AIza...
#
# Used by:
#   supabase/functions/create-payment   (Paystack checkout, NGN)
#   supabase/functions/verify-payment   (verify + wallet credit)
#   supabase/functions/gemini-proxy     (AI recommendations without key leaks)
#
# Deploy functions with:  supabase functions deploy create-payment verify-payment gemini-proxy
